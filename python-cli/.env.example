# Copy to python-cli/.env and fill in. The CLI also reads these from the shell.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the service role key for full CRUD, or the anon key if you
# rely only on the permissive RLS policy in supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_EDGE_FUNCTION_URL=https://YOUR_PROJECT_REF.functions.supabase.co/validate-upload